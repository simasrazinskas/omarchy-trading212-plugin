{
  "schemaVersion": 1,
  "id": "io.github.simasrazinskas.trading212",
  "name": "Trading 212",
  "version": "0.6.0",
  "author": "Simas Razinskas",
  "license": "MIT",
  "description": "Trading 212 portfolio monitor for the Omarchy bar: account value with spending pot, P/L and daily change at a glance; a tabbed panel with holdings, market data, spending, activity, insights and alerts.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Trading 212",
    "description": "Account value and P/L in the bar; left-click for Overview · Holdings · Cash · Activity · Insights, right-click to cycle display modes, middle-click to refresh.",
    "category": "Info",
    "aliases": [
      "trading212",
      "t212",
      "portfolio",
      "stocks"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60,
      "environment": "live",
      "mode": "invested",
      "marketData": true,
      "alerts": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "environment",
        "type": "enum",
        "label": "Account",
        "options": [
          "live",
          "demo"
        ],
        "defaultValue": "live"
      },
      {
        "key": "marketData",
        "type": "boolean",
        "label": "Public market data (Nasdaq, ECB, CNN, Google News)",
        "defaultValue": true
      },
      {
        "key": "alerts",
        "type": "boolean",
        "label": "Desktop notifications",
        "defaultValue": true
      }
    ]
  }
}
