{
  "schemaVersion": 1,
  "id": "io.github.simasrazinskas.trading212",
  "name": "Trading 212",
  "version": "0.2.0",
  "author": "Simas Razinskas",
  "license": "MIT",
  "description": "Trading 212 portfolio in the Omarchy bar: invested amount and P/L at a glance, with a detail panel of positions.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Trading 212",
    "description": "Invested amount and P/L in the bar; left-click for account details and positions, right-click to cycle display modes.",
    "category": "Info",
    "aliases": ["trading212", "t212", "portfolio", "stocks"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60,
      "environment": "live",
      "mode": "invested"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      }
    ]
  }
}
